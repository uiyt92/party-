    table.cell(fill: rgb("1e3a8a"))[#text(fill: white, weight: 700, size: 9pt)[체크 개수]],
    table.cell(fill: rgb("1e3a8a"))[#text(fill: white, weight: 700, size: 9pt)[진단]],
    table.cell(fill: rgb("1e3a8a"))[#text(fill: white, weight: 700, size: 9pt)[한 줄 처방]],
    [#text(size: 9pt)[0\~1개]],
