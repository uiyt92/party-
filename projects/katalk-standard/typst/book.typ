  #table(
    columns: (1fr, 1fr, 1fr, 1fr),
    stroke: (x: none, y: 0.5pt + luma(200)),
    inset: (x: 6pt, y: 6pt),
    table.cell(fill: rgb("1e3a8a"))[#text(fill: white, weight: 700, size: 9pt)[멘트 예시]],
    table.cell(fill: rgb("1e3a8a"))[#text(fill: white, weight: 700, size: 9pt)[정체]],
    table.cell(fill: rgb("1e3a8a"))[#text(fill: white, weight: 700, size: 9pt)[신호 읽기]],
    table.cell(fill: rgb("1e3a8a"))[#text(fill: white, weight: 700, size: 9pt)[대응]],
    [#text(size: 9pt)["이번 주는 좀 바쁜데 담주는 괜찮아요"]],
    [#text(size: 9pt)[단순 바쁨]],
    [#text(size: 9pt)[거절이 아니라 일정 조율. 대안을 먼저 줬다]],
    [#text(size: 9pt)[담주로 바로 받는다. "콜 그럼 담주로 잡아요"]],
    [#text(size: 9pt)["요즘 일이 많아서 ㅠㅠ 정신 차리면 연락할게요"]],
